TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=.telethon/mirror

DATABASE_URL=postgresql://mirror:mirror@localhost:5432/mirror

# Embeddings run locally (no API key). Set EMBEDDING_PROVIDER=local to use
# sentence-transformers on-box. openai / dry-run remain available.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBED_BATCH_SIZE=100

# Drafting runs via `codex exec` (GPT-5.5 over ChatGPT OAuth, no API key).
# LLM_PROVIDER=codex | openai | dry-run
LLM_PROVIDER=codex
LLM_MODEL=gpt-5.5
LLM_API_KEY=
CODEX_REASONING_EFFORT=high

STYLE_EXAMPLE_LIMIT=5
STYLE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STYLE_EMBEDDING_API_KEY=
RETRIEVE_TOP_K=6

# --- Living style sheet (agent/style_sheet.py) ---
# How many of the owner's own messages to sample for the stylometric profile.
STYLE_SHEET_SAMPLE_SIZE=400
# How many recent owner edits to feed the distillation as refinement signal.
STYLE_SHEET_MAX_EDITS=40
# Anti-overfit staging: a mined rule graduates into the ACTIVE guide only after
# this many INDEPENDENT edits support it. One-offs stay candidates.
STYLE_RULE_PROMOTE_THRESHOLD=3
# A promoted rule decays back out after this many regenerations with no
# supporting edit reappearing.
STYLE_RULE_DECAY_MISSES=3

# --- LIVE approve-UI service (agent/service.py) ---
# The Mirror BOT token (from @BotFather) drives the approve UI. Until this is
# set, the service runs the user watcher but the approve UI is OFFLINE and
# NOTHING is sent. Add it here and restart to go live.
MIRROR_BOT_TOKEN=
# Set to 1 to resume older-history backfill as a background task inside the
# live client (instead of the standalone ingest/backfill_drip.sh).
MIRROR_RESUME_BACKFILL=0
MIRROR_LOG_LEVEL=INFO

# Legacy python-telegram-bot scaffold (agent/bot.py) — not used by service.py.
TELEGRAM_BOT_TOKEN=
OWNER_APPROVAL_CHAT_ID=

# Owner identity (env-ified; keep real values only in .env)
MIRROR_OWNER_USER_ID=
MIRROR_EXCLUDED_TOPIC_CHAT_ID=
